# Django runtime
DJANGO_SETTINGS_MODULE=family_guard.settings
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,family-guard-xb0x.onrender.com

# Admin credentials kept in environment variables for deployment
ADMIN_USERNAME=Admin111
ADMIN_EMAIL=admin111@gmail.com
ADMIN_PASSWORD=Admin1234

# Render/Postgres connection string should be supplied by the Render service environment.
# Example PostgreSQL value stored in Render environment:
# postgres://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgres://family_guard:family_guard_password@localhost:5432/family_guard_db

# Local fallback remains SQLite for development if DATABASE_URL is not injected.
# DATABASE_URL=sqlite:///db.sqlite3
